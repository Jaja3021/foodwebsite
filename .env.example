# Supabase (leave blank to run the built-in local demo database instead)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Stripe TEST MODE (leave blank to use the built-in Demo Payment Simulator)
VITE_STRIPE_PUBLISHABLE_KEY=
VITE_PAYMENT_API_URL=

# Server-side only — NEVER prefix with VITE_, never used in frontend code.
# Set this only on the server that creates Stripe PaymentIntents.
STRIPE_SECRET_KEY=
